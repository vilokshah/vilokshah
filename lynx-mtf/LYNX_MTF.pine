//@version=6
indicator("LYNX MTF", shorttitle="LYNX MTF", overlay=true, max_boxes_count=20, max_lines_count=150, max_labels_count=200)

// ═══════════════════════════════════════════════════════════════
// LYNX MTF — reversal at swing extremes + daily BSL/SSL
// Chart: 15m / 1H / 4H only
// Confirm TF: 5m / 15m / 1H
// TP = full prior MOVE from the pattern. SL = half that move
// beyond the pattern extreme. TP2+ = same length again.
// ═══════════════════════════════════════════════════════════════

// ── Inputs ─────────────────────────────────────────────────────
i_showBSL     = input.bool(true, "Show daily BSL / SSL", group="BSL / SSL")
i_showCdh     = input.bool(true, "Show developing day high / low", group="BSL / SSL")
i_requireLiq  = input.bool(true, "Pattern must be near daily SSL (buy) or BSL (sell)", group="BSL / SSL")
i_liqAtr      = input.float(0.75, "Liquidity proximity (ATR)", minval=0.1, step=0.05, group="BSL / SSL")

i_showHammer  = input.bool(true, "Hammer / Shooting Star", group="Patterns")
i_showEngulf  = input.bool(true, "Bullish / Bearish Engulfing", group="Patterns")
i_showMornEve = input.bool(true, "Morning Star / Evening Star", group="Patterns")
i_showTweezer = input.bool(true, "Tweezer Top / Bottom", group="Patterns")
i_wickRatio   = input.float(2.0, "Min Wick : Body Ratio", minval=1.0, step=0.1, group="Patterns")
i_bodyFactor  = input.float(1.2, "Engulfing Body Factor", minval=1.0, step=0.1, group="Patterns")
i_swingLen    = input.int(5, "Local swing lookback (bars)", minval=2, maxval=20, group="Patterns")
i_moveLook    = input.int(30, "Move lookback (bars)", minval=8, maxval=100, group="Patterns")
i_minAtr      = input.float(1.5, "Min move size (ATR)", minval=0.0, step=0.1, group="Patterns")
i_waitBars    = input.int(12, "Cancel pending if no LTF confirm (bars)", minval=2, maxval=50, group="Patterns")

i_showEntry   = input.bool(true, "Show Entry Line", group="Trade Levels")
i_showSL      = input.bool(true, "Show Stop-Loss", group="Trade Levels")
i_slFrac      = input.float(0.5, "SL = this fraction of the MOVE beyond pattern", minval=0.1, maxval=1.0, step=0.1, group="Trade Levels")
i_tpCount     = input.int(8, "Number of TP multiples", minval=1, maxval=8, group="Trade Levels")

i_colBull     = input.color(color.new(#00c853, 0), "Bullish", group="Colors")
i_colBear     = input.color(color.new(#f44336, 0), "Bearish", group="Colors")
i_colEntry    = input.color(color.new(#f5a623, 0), "Entry", group="Colors")
i_colSL       = input.color(color.new(#e53935, 0), "SL", group="Colors")
i_colTP       = input.color(color.new(#00e676, 0), "TP Lines", group="Colors")
i_colBSL      = input.color(color.new(#2196f3, 0), "BSL", group="Colors")
i_colSSL      = input.color(color.new(#ff9800, 0), "SSL", group="Colors")

LBL_OFF = 3

// ── Timeframe guard ────────────────────────────────────────────
v_tf = timeframe.period
if v_tf != "15" and v_tf != "60" and v_tf != "240"
    runtime.error("LYNX MTF: load on a 15m, 1H or 4H chart.")

v_ctf = v_tf == "240" ? "60" : v_tf == "60" ? "15" : "5"
f_tfName(string p) =>
    p == "5" ? "5m" : p == "15" ? "15m" : p == "60" ? "1H" : p == "240" ? "4H" : p
v_tfName  = f_tfName(v_tf)
v_ctfName = f_tfName(v_ctf)

f_px(float p) => str.tostring(p, format.mintick)

// ── State ──────────────────────────────────────────────────────
var bool   s_waitBull  = false
var bool   s_waitBear  = false
var int    s_waitFrom  = na
var float  s_wpH       = na
var float  s_wpL       = na
var float  s_move      = na
var string s_wpName    = ""
var bool   s_live      = false
var bool   s_isBull    = false
var float  s_entry     = na
var float  s_sl        = na
var float  s_range     = na
var int    s_tpReached = 0
var int    s_sigToday  = 0
var int    s_winsToday = 0
var int    s_lossToday = 0
var int    s_lastDay   = 0

// ── Daily BSL / SSL (previous day high / low) ──────────────────
[v_pdh, v_pdl, v_cdh, v_cdl] = request.security(syminfo.tickerid, "D", [high[1], low[1], high, low], lookahead=barmerge.lookahead_off)

var line  v_lineBSL = na
var line  v_lineSSL = na
var line  v_lineCDH = na
var line  v_lineCDL = na
var label v_lblBSL  = na
var label v_lblSSL  = na

if i_showBSL and barstate.islast
    line.delete(v_lineBSL)
    line.delete(v_lineSSL)
    line.delete(v_lineCDH)
    line.delete(v_lineCDL)
    label.delete(v_lblBSL)
    label.delete(v_lblSSL)
    if not na(v_pdh)
        v_lineBSL := line.new(bar_index - 8, v_pdh, bar_index, v_pdh, color=i_colBSL, width=2, style=line.style_dashed, extend=extend.right)
        v_lblBSL  := label.new(bar_index + LBL_OFF, v_pdh, "BSL  PDH  " + f_px(v_pdh), color=color.new(i_colBSL, 20), textcolor=color.white, style=label.style_label_left, size=size.small)
    if not na(v_pdl)
        v_lineSSL := line.new(bar_index - 8, v_pdl, bar_index, v_pdl, color=i_colSSL, width=2, style=line.style_dashed, extend=extend.right)
        v_lblSSL  := label.new(bar_index + LBL_OFF, v_pdl, "SSL  PDL  " + f_px(v_pdl), color=color.new(i_colSSL, 20), textcolor=color.white, style=label.style_label_left, size=size.small)
    if i_showCdh and not na(v_cdh)
        v_lineCDH := line.new(bar_index - 4, v_cdh, bar_index, v_cdh, color=color.new(i_colBSL, 40), width=1, style=line.style_dotted, extend=extend.right)
    if i_showCdh and not na(v_cdl)
        v_lineCDL := line.new(bar_index - 4, v_cdl, bar_index, v_cdl, color=color.new(i_colSSL, 40), width=1, style=line.style_dotted, extend=extend.right)

// ── Candle helpers (closed bars) ───────────────────────────────
f_body(int i)    => math.abs(close[i] - open[i])
f_upWick(int i)  => high[i] - math.max(close[i], open[i])
f_dnWick(int i)  => math.min(close[i], open[i]) - low[i]
f_rng(int i)     => high[i] - low[i]
f_isBull(int i)  => close[i] > open[i]
f_isBear(int i)  => close[i] < open[i]
f_midBody(int i) => (open[i] + close[i]) / 2.0

// Close in the upper / lower portion of the candle (clear hammer / star)
f_closeHigh(int i) => f_rng(i) > 0 and (close[i] - low[i]) / f_rng(i) >= 0.60
f_closeLow(int i)  => f_rng(i) > 0 and (high[i] - close[i]) / f_rng(i) >= 0.60

f_hammer() =>
    b = f_body(1)
    b > 0 and f_dnWick(1) >= i_wickRatio * b and f_upWick(1) <= b * 0.5 and f_closeHigh(1)

f_shootingStar() =>
    b = f_body(1)
    b > 0 and f_upWick(1) >= i_wickRatio * b and f_dnWick(1) <= b * 0.5 and f_closeLow(1)

f_bullEngulf() =>
    f_isBear(2) and f_isBull(1) and f_body(1) >= i_bodyFactor * f_body(2) and open[1] <= close[2] and close[1] >= open[2]

f_bearEngulf() =>
    f_isBull(2) and f_isBear(1) and f_body(1) >= i_bodyFactor * f_body(2) and open[1] >= close[2] and close[1] <= open[2]

f_morningStar() =>
    c1 = f_isBear(3) and f_body(3) > f_body(2) * 2
    c2 = f_body(2) < f_body(3) * 0.5
    c3 = f_isBull(1) and f_body(1) > f_body(2) * 2
    c1 and c2 and c3 and close[1] >= f_midBody(3)

f_eveningStar() =>
    c1 = f_isBull(3) and f_body(3) > f_body(2) * 2
    c2 = f_body(2) < f_body(3) * 0.5
    c3 = f_isBear(1) and f_body(1) > f_body(2) * 2
    c1 and c2 and c3 and close[1] <= f_midBody(3)

f_tweezerBottom() =>
    avg = (f_body(1) + f_body(2)) / 2.0
    avg > 0 and f_isBear(2) and f_isBull(1) and math.abs(low[1] - low[2]) <= avg * 0.2

f_tweezerTop() =>
    avg = (f_body(1) + f_body(2)) / 2.0
    avg > 0 and f_isBull(2) and f_isBear(1) and math.abs(high[1] - high[2]) <= avg * 0.2

// ── Location: local swing + real prior MOVE ────────────────────
v_atr = ta.atr(14)
v_atSwingLow  = low[1]  == ta.lowest(low,  i_swingLen + 1)
v_atSwingHigh = high[1] == ta.highest(high, i_swingLen + 1)

// Prior swing extreme excluding the pattern bar itself
v_moveHigh = ta.highest(high[2], i_moveLook)
v_moveLow  = ta.lowest(low[2],  i_moveLook)
v_drop     = v_moveHigh - low[1]
v_rally    = high[1] - v_moveLow
v_dropOk   = i_minAtr <= 0 or v_drop  >= i_minAtr * v_atr
v_rallyOk  = i_minAtr <= 0 or v_rally >= i_minAtr * v_atr

v_nearSSL = na(v_pdl) or low[1]  <= v_pdl + i_liqAtr * v_atr
v_nearBSL = na(v_pdh) or high[1] >= v_pdh - i_liqAtr * v_atr
v_liqBuy  = not i_requireLiq or v_nearSSL
v_liqSell = not i_requireLiq or v_nearBSL

v_pH1 = high[1]
v_pL1 = low[1]
v_pH2 = math.max(high[1], high[2])
v_pL2 = math.min(low[1],  low[2])
v_pH3 = math.max(high[1], math.max(high[2], high[3]))
v_pL3 = math.min(low[1],  math.min(low[2],  low[3]))

v_bullHammer = i_showHammer  and f_hammer()        and v_atSwingLow  and v_dropOk  and v_liqBuy
v_bullEngulf = i_showEngulf  and f_bullEngulf()    and v_atSwingLow  and v_dropOk  and v_liqBuy
v_bullMorn   = i_showMornEve and f_morningStar()   and v_atSwingLow  and v_dropOk  and v_liqBuy
v_bullTweez  = i_showTweezer and f_tweezerBottom() and v_atSwingLow  and v_dropOk  and v_liqBuy
v_bullSig    = v_bullHammer or v_bullEngulf or v_bullMorn or v_bullTweez

v_bearStar   = i_showHammer  and f_shootingStar()  and v_atSwingHigh and v_rallyOk and v_liqSell
v_bearEngulf = i_showEngulf  and f_bearEngulf()    and v_atSwingHigh and v_rallyOk and v_liqSell
v_bearEve    = i_showMornEve and f_eveningStar()   and v_atSwingHigh and v_rallyOk and v_liqSell
v_bearTweez  = i_showTweezer and f_tweezerTop()    and v_atSwingHigh and v_rallyOk and v_liqSell
v_bearSig    = v_bearStar or v_bearEngulf or v_bearEve or v_bearTweez

if v_bullSig
    s_waitBull := true
    s_waitBear := false
    s_waitFrom := bar_index
    s_wpH      := v_bullMorn ? v_pH3 : (v_bullEngulf or v_bullTweez) ? v_pH2 : v_pH1
    s_wpL      := v_bullMorn ? v_pL3 : (v_bullEngulf or v_bullTweez) ? v_pL2 : v_pL1
    s_move     := math.max(v_moveHigh - s_wpL, v_atr)
    s_wpName   := v_bullHammer ? "Hammer" : v_bullEngulf ? "Bull Engulf" : v_bullMorn ? "Morning Star" : "Tweezer Bot"

if v_bearSig
    s_waitBear := true
    s_waitBull := false
    s_waitFrom := bar_index
    s_wpH      := v_bearEve ? v_pH3 : (v_bearEngulf or v_bearTweez) ? v_pH2 : v_pH1
    s_wpL      := v_bearEve ? v_pL3 : (v_bearEngulf or v_bearTweez) ? v_pL2 : v_pL1
    s_move     := math.max(s_wpH - v_moveLow, v_atr)
    s_wpName   := v_bearStar ? "Shoot Star" : v_bearEngulf ? "Bear Engulf" : v_bearEve ? "Evening Star" : "Tweezer Top"

// ── Pending timeout ────────────────────────────────────────────
v_waitExpired = (s_waitBull or s_waitBear) and not na(s_waitFrom) and (bar_index - s_waitFrom) > i_waitBars

// ── Lower-TF confirmation (closed LTF candles only) ────────────
v_ltfC1 = request.security(syminfo.tickerid, v_ctf, close[1], lookahead=barmerge.lookahead_off)
v_ltfO1 = request.security(syminfo.tickerid, v_ctf, open[1],  lookahead=barmerge.lookahead_off)
v_ltfC2 = request.security(syminfo.tickerid, v_ctf, close[2], lookahead=barmerge.lookahead_off)
v_ltfO2 = request.security(syminfo.tickerid, v_ctf, open[2],  lookahead=barmerge.lookahead_off)
v_ltfC3 = request.security(syminfo.tickerid, v_ctf, close[3], lookahead=barmerge.lookahead_off)
v_ltfO3 = request.security(syminfo.tickerid, v_ctf, open[3],  lookahead=barmerge.lookahead_off)

v_ltfBullOk = (v_ltfC1 > v_ltfO1 and v_ltfC1 > s_wpH) or (v_ltfC2 > v_ltfO2 and v_ltfC2 > s_wpH) or (v_ltfC3 > v_ltfO3 and v_ltfC3 > s_wpH)
v_ltfBearOk = (v_ltfC1 < v_ltfO1 and v_ltfC1 < s_wpL) or (v_ltfC2 < v_ltfO2 and v_ltfC2 < s_wpL) or (v_ltfC3 < v_ltfO3 and v_ltfC3 < s_wpL)

v_bullConfirmed = s_waitBull and v_ltfBullOk and not s_live and not v_waitExpired
v_bearConfirmed = s_waitBear and v_ltfBearOk and not s_live and not v_waitExpired

if v_bullConfirmed
    s_waitBull := false
if v_bearConfirmed
    s_waitBear := false

// ── Session stats (today only) ─────────────────────────────────
v_barDay  = year * 10000 + month * 100 + dayofmonth
v_isToday = year == year(timenow) and month == month(timenow) and dayofmonth == dayofmonth(timenow)

if v_barDay != s_lastDay
    s_sigToday  := 0
    s_winsToday := 0
    s_lossToday := 0
    s_lastDay   := v_barDay

if v_isToday and (v_bullConfirmed or v_bearConfirmed)
    s_sigToday := s_sigToday + 1

// ── Drawings ───────────────────────────────────────────────────
var box   d_pendBox = na
var label d_pendLbl = na
var line  d_entLn   = na
var label d_entLb   = na
var line  d_slLn    = na
var label d_slLb    = na
var label d_cfmLb   = na
var line  d_t1Ln    = na
var line  d_t2Ln    = na
var line  d_t3Ln    = na
var line  d_t4Ln    = na
var line  d_t5Ln    = na
var line  d_t6Ln    = na
var line  d_t7Ln    = na
var line  d_t8Ln    = na
var label d_t1Lb    = na
var label d_t2Lb    = na
var label d_t3Lb    = na
var label d_t4Lb    = na
var label d_t5Lb    = na
var label d_t6Lb    = na
var label d_t7Lb    = na
var label d_t8Lb    = na
var line  d_m1Ln    = na
var line  d_m2Ln    = na
var line  d_m3Ln    = na
var line  d_m4Ln    = na
var line  d_m5Ln    = na
var line  d_m6Ln    = na
var line  d_m7Ln    = na
var line  d_mvLn    = na
var label d_mvLb    = na

f_clearPending() =>
    box.delete(d_pendBox)
    label.delete(d_pendLbl)
    d_pendBox := na
    d_pendLbl := na

f_clearTrade() =>
    line.delete(d_entLn)
    label.delete(d_entLb)
    line.delete(d_slLn)
    label.delete(d_slLb)
    label.delete(d_cfmLb)
    line.delete(d_t1Ln)
    line.delete(d_t2Ln)
    line.delete(d_t3Ln)
    line.delete(d_t4Ln)
    line.delete(d_t5Ln)
    line.delete(d_t6Ln)
    line.delete(d_t7Ln)
    line.delete(d_t8Ln)
    label.delete(d_t1Lb)
    label.delete(d_t2Lb)
    label.delete(d_t3Lb)
    label.delete(d_t4Lb)
    label.delete(d_t5Lb)
    label.delete(d_t6Lb)
    label.delete(d_t7Lb)
    label.delete(d_t8Lb)
    line.delete(d_m1Ln)
    line.delete(d_m2Ln)
    line.delete(d_m3Ln)
    line.delete(d_m4Ln)
    line.delete(d_m5Ln)
    line.delete(d_m6Ln)
    line.delete(d_m7Ln)
    line.delete(d_mvLn)
    label.delete(d_mvLb)
    d_entLn := na
    d_entLb := na
    d_slLn := na
    d_slLb := na
    d_cfmLb := na
    d_t1Ln := na
    d_t2Ln := na
    d_t3Ln := na
    d_t4Ln := na
    d_t5Ln := na
    d_t6Ln := na
    d_t7Ln := na
    d_t8Ln := na
    d_t1Lb := na
    d_t2Lb := na
    d_t3Lb := na
    d_t4Lb := na
    d_t5Lb := na
    d_t6Lb := na
    d_t7Lb := na
    d_t8Lb := na
    d_m1Ln := na
    d_m2Ln := na
    d_m3Ln := na
    d_m4Ln := na
    d_m5Ln := na
    d_m6Ln := na
    d_m7Ln := na
    d_mvLn := na
    d_mvLb := na

if v_waitExpired
    f_clearPending()
    s_waitBull := false
    s_waitBear := false

if v_bullSig
    f_clearPending()
    v_sb = v_bullMorn ? 3 : (v_bullEngulf or v_bullTweez) ? 2 : 1
    d_pendBox := box.new(bar_index - v_sb, s_wpH, bar_index, s_wpL, border_color=color.new(i_colBull, 40), bgcolor=color.new(i_colBull, 90), border_width=1, border_style=line.style_dashed)
    d_pendLbl := label.new(bar_index, s_wpL, "BUY " + s_wpName + " | Wait " + v_ctfName, color=i_colBull, textcolor=color.white, style=label.style_label_up, size=size.small)

if v_bearSig
    f_clearPending()
    v_sb = v_bearEve ? 3 : (v_bearEngulf or v_bearTweez) ? 2 : 1
    d_pendBox := box.new(bar_index - v_sb, s_wpH, bar_index, s_wpL, border_color=color.new(i_colBear, 40), bgcolor=color.new(i_colBear, 90), border_width=1, border_style=line.style_dashed)
    d_pendLbl := label.new(bar_index, s_wpH, "SELL " + s_wpName + " | Wait " + v_ctfName, color=i_colBear, textcolor=color.white, style=label.style_label_down, size=size.small)

if (s_waitBull or s_waitBear) and not na(d_pendBox)
    box.set_right(d_pendBox, bar_index)

v_doConfirm = v_bullConfirmed or v_bearConfirmed
if v_doConfirm
    f_clearPending()
    f_clearTrade()
    s_live      := true
    s_tpReached := 0

f_tpLine(int n, float px, int transp) =>
    n <= i_tpCount ? line.new(bar_index - 1, px, bar_index, px, color=color.new(i_colTP, transp), width=1, style=line.style_solid, extend=extend.right) : na

f_tpLabel(int n, float px) =>
    n <= i_tpCount ? label.new(bar_index + LBL_OFF, px, "TP" + str.tostring(n) + "  " + f_px(px), color=color.new(#1b5e20, 0), textcolor=color.white, style=label.style_label_left, size=size.small) : na

f_midLine(int n, float px) =>
    n < i_tpCount ? line.new(bar_index - 1, px, bar_index, px, color=color.new(i_colTP, 55), width=1, style=line.style_dotted, extend=extend.right) : na

if v_bullConfirmed
    v_ent = s_wpH
    v_sl  = s_wpL - s_move * i_slFrac
    v_rng = s_move
    s_isBull := true
    s_entry  := v_ent
    s_sl     := v_sl
    s_range  := v_rng
    if i_showEntry
        d_entLn := line.new(bar_index - 1, v_ent, bar_index, v_ent, color=i_colEntry, width=2, style=line.style_solid, extend=extend.right)
        d_entLb := label.new(bar_index + LBL_OFF, v_ent, "ENTRY  " + f_px(v_ent), color=i_colEntry, textcolor=color.black, style=label.style_label_left, size=size.small)
    if i_showSL
        d_slLn := line.new(bar_index - 1, v_sl, bar_index, v_sl, color=i_colSL, width=1, style=line.style_dashed, extend=extend.right)
        d_slLb := label.new(bar_index + LBL_OFF, v_sl, "SL  " + f_px(v_sl), color=i_colSL, textcolor=color.white, style=label.style_label_left, size=size.small)
    v_t1 = v_ent + v_rng * 1
    v_t2 = v_ent + v_rng * 2
    v_t3 = v_ent + v_rng * 3
    v_t4 = v_ent + v_rng * 4
    v_t5 = v_ent + v_rng * 5
    v_t6 = v_ent + v_rng * 6
    v_t7 = v_ent + v_rng * 7
    v_t8 = v_ent + v_rng * 8
    d_t1Ln := f_tpLine(1, v_t1, 0)
    d_t2Ln := f_tpLine(2, v_t2, 12)
    d_t3Ln := f_tpLine(3, v_t3, 22)
    d_t4Ln := f_tpLine(4, v_t4, 32)
    d_t5Ln := f_tpLine(5, v_t5, 42)
    d_t6Ln := f_tpLine(6, v_t6, 52)
    d_t7Ln := f_tpLine(7, v_t7, 62)
    d_t8Ln := f_tpLine(8, v_t8, 70)
    d_t1Lb := f_tpLabel(1, v_t1)
    d_t2Lb := f_tpLabel(2, v_t2)
    d_t3Lb := f_tpLabel(3, v_t3)
    d_t4Lb := f_tpLabel(4, v_t4)
    d_t5Lb := f_tpLabel(5, v_t5)
    d_t6Lb := f_tpLabel(6, v_t6)
    d_t7Lb := f_tpLabel(7, v_t7)
    d_t8Lb := f_tpLabel(8, v_t8)
    d_m1Ln := f_midLine(1, (v_ent + v_t1) / 2.0)
    d_m2Ln := f_midLine(2, (v_t1 + v_t2) / 2.0)
    d_m3Ln := f_midLine(3, (v_t2 + v_t3) / 2.0)
    d_m4Ln := f_midLine(4, (v_t3 + v_t4) / 2.0)
    d_m5Ln := f_midLine(5, (v_t4 + v_t5) / 2.0)
    d_m6Ln := f_midLine(6, (v_t5 + v_t6) / 2.0)
    d_m7Ln := f_midLine(7, (v_t6 + v_t7) / 2.0)
    v_risk = v_ent - v_sl
    v_rr   = v_risk > 0 ? math.round(v_rng / v_risk, 1) : 0.0
    d_cfmLb := label.new(bar_index, v_ent, "BUY " + s_wpName + " | " + v_ctfName + " | R:R 1:" + str.tostring(v_rr), color=i_colBull, textcolor=color.white, style=label.style_label_up, size=size.small)
    d_mvLn := line.new(bar_index - i_moveLook, v_moveHigh, bar_index - 1, v_moveHigh, color=color.new(i_colBull, 50), width=1, style=line.style_dotted)
    d_mvLb := label.new(bar_index - i_moveLook, v_moveHigh, "MOVE  " + f_px(v_rng), color=color.new(i_colBull, 40), textcolor=color.white, style=label.style_label_down, size=size.tiny)
    alert("LYNX BUY " + syminfo.ticker + " " + v_tfName + " " + s_wpName + " ENTRY " + f_px(v_ent) + " SL " + f_px(v_sl) + " TP1 " + f_px(v_t1), alert.freq_once_per_bar)

if v_bearConfirmed
    v_ent = s_wpL
    v_sl  = s_wpH + s_move * i_slFrac
    v_rng = s_move
    s_isBull := false
    s_entry  := v_ent
    s_sl     := v_sl
    s_range  := v_rng
    if i_showEntry
        d_entLn := line.new(bar_index - 1, v_ent, bar_index, v_ent, color=i_colEntry, width=2, style=line.style_solid, extend=extend.right)
        d_entLb := label.new(bar_index + LBL_OFF, v_ent, "ENTRY  " + f_px(v_ent), color=i_colEntry, textcolor=color.black, style=label.style_label_left, size=size.small)
    if i_showSL
        d_slLn := line.new(bar_index - 1, v_sl, bar_index, v_sl, color=i_colSL, width=1, style=line.style_dashed, extend=extend.right)
        d_slLb := label.new(bar_index + LBL_OFF, v_sl, "SL  " + f_px(v_sl), color=i_colSL, textcolor=color.white, style=label.style_label_left, size=size.small)
    v_t1 = v_ent - v_rng * 1
    v_t2 = v_ent - v_rng * 2
    v_t3 = v_ent - v_rng * 3
    v_t4 = v_ent - v_rng * 4
    v_t5 = v_ent - v_rng * 5
    v_t6 = v_ent - v_rng * 6
    v_t7 = v_ent - v_rng * 7
    v_t8 = v_ent - v_rng * 8
    d_t1Ln := f_tpLine(1, v_t1, 0)
    d_t2Ln := f_tpLine(2, v_t2, 12)
    d_t3Ln := f_tpLine(3, v_t3, 22)
    d_t4Ln := f_tpLine(4, v_t4, 32)
    d_t5Ln := f_tpLine(5, v_t5, 42)
    d_t6Ln := f_tpLine(6, v_t6, 52)
    d_t7Ln := f_tpLine(7, v_t7, 62)
    d_t8Ln := f_tpLine(8, v_t8, 70)
    d_t1Lb := f_tpLabel(1, v_t1)
    d_t2Lb := f_tpLabel(2, v_t2)
    d_t3Lb := f_tpLabel(3, v_t3)
    d_t4Lb := f_tpLabel(4, v_t4)
    d_t5Lb := f_tpLabel(5, v_t5)
    d_t6Lb := f_tpLabel(6, v_t6)
    d_t7Lb := f_tpLabel(7, v_t7)
    d_t8Lb := f_tpLabel(8, v_t8)
    d_m1Ln := f_midLine(1, (v_ent + v_t1) / 2.0)
    d_m2Ln := f_midLine(2, (v_t1 + v_t2) / 2.0)
    d_m3Ln := f_midLine(3, (v_t2 + v_t3) / 2.0)
    d_m4Ln := f_midLine(4, (v_t3 + v_t4) / 2.0)
    d_m5Ln := f_midLine(5, (v_t4 + v_t5) / 2.0)
    d_m6Ln := f_midLine(6, (v_t5 + v_t6) / 2.0)
    d_m7Ln := f_midLine(7, (v_t6 + v_t7) / 2.0)
    v_risk = v_sl - v_ent
    v_rr   = v_risk > 0 ? math.round(v_rng / v_risk, 1) : 0.0
    d_cfmLb := label.new(bar_index, v_ent, "SELL " + s_wpName + " | " + v_ctfName + " | R:R 1:" + str.tostring(v_rr), color=i_colBear, textcolor=color.white, style=label.style_label_down, size=size.small)
    d_mvLn := line.new(bar_index - i_moveLook, v_moveLow, bar_index - 1, v_moveLow, color=color.new(i_colBear, 50), width=1, style=line.style_dotted)
    d_mvLb := label.new(bar_index - i_moveLook, v_moveLow, "MOVE  " + f_px(v_rng), color=color.new(i_colBear, 40), textcolor=color.white, style=label.style_label_up, size=size.tiny)
    alert("LYNX SELL " + syminfo.ticker + " " + v_tfName + " " + s_wpName + " ENTRY " + f_px(v_ent) + " SL " + f_px(v_sl) + " TP1 " + f_px(v_t1), alert.freq_once_per_bar)

f_greyTp(line ln, label lb, bool hit) =>
    if hit and not na(ln)
        line.set_color(ln, color.new(color.gray, 30))
        label.set_color(lb, color.new(color.gray, 20))
        label.set_textcolor(lb, color.white)

if s_live
    v_tp1p = s_isBull ? s_entry + s_range * 1 : s_entry - s_range * 1
    v_tp2p = s_isBull ? s_entry + s_range * 2 : s_entry - s_range * 2
    v_tp3p = s_isBull ? s_entry + s_range * 3 : s_entry - s_range * 3
    v_tp4p = s_isBull ? s_entry + s_range * 4 : s_entry - s_range * 4
    v_tp5p = s_isBull ? s_entry + s_range * 5 : s_entry - s_range * 5
    v_tp6p = s_isBull ? s_entry + s_range * 6 : s_entry - s_range * 6
    v_tp7p = s_isBull ? s_entry + s_range * 7 : s_entry - s_range * 7
    v_tp8p = s_isBull ? s_entry + s_range * 8 : s_entry - s_range * 8
    f_greyTp(d_t1Ln, d_t1Lb, s_isBull ? high >= v_tp1p : low <= v_tp1p)
    f_greyTp(d_t2Ln, d_t2Lb, s_isBull ? high >= v_tp2p : low <= v_tp2p)
    f_greyTp(d_t3Ln, d_t3Lb, s_isBull ? high >= v_tp3p : low <= v_tp3p)
    f_greyTp(d_t4Ln, d_t4Lb, s_isBull ? high >= v_tp4p : low <= v_tp4p)
    f_greyTp(d_t5Ln, d_t5Lb, s_isBull ? high >= v_tp5p : low <= v_tp5p)
    f_greyTp(d_t6Ln, d_t6Lb, s_isBull ? high >= v_tp6p : low <= v_tp6p)
    f_greyTp(d_t7Ln, d_t7Lb, s_isBull ? high >= v_tp7p : low <= v_tp7p)
    f_greyTp(d_t8Ln, d_t8Lb, s_isBull ? high >= v_tp8p : low <= v_tp8p)
    for n = 1 to 8
        if n <= i_tpCount
            v_tp  = s_isBull ? s_entry + s_range * n : s_entry - s_range * n
            v_hit = s_isBull ? high >= v_tp : low <= v_tp
            if v_hit and n > s_tpReached
                s_tpReached := n

v_slHit = s_live and (s_isBull ? low <= s_sl : high >= s_sl)

if v_slHit
    if v_isToday
        if s_tpReached >= 1
            s_winsToday := s_winsToday + 1
        else
            s_lossToday := s_lossToday + 1
    f_clearTrade()
    s_live      := false
    s_tpReached := 0

if s_live and not v_slHit and s_tpReached >= 1
    v_tpTop  = s_isBull ? s_entry + s_range * s_tpReached : s_entry - s_range * s_tpReached
    v_tpPrev = s_tpReached > 1 ? (s_isBull ? s_entry + s_range * (s_tpReached - 1) : s_entry - s_range * (s_tpReached - 1)) : s_entry
    v_mid    = (v_tpTop + v_tpPrev) / 2.0
    v_inv    = s_isBull ? close < v_mid : close > v_mid
    if v_inv
        if v_isToday
            s_winsToday := s_winsToday + 1
        s_live := false

barcolor(v_bullConfirmed ? color.new(i_colBull, 20) : v_bearConfirmed ? color.new(i_colBear, 20) : na)

alertcondition(v_bullSig,       title="[LYNX] BUY Setup Forming",    message="BUY SETUP: {{ticker}} {{interval}} waiting lower TF confirm.")
alertcondition(v_bearSig,       title="[LYNX] SELL Setup Forming",   message="SELL SETUP: {{ticker}} {{interval}} waiting lower TF confirm.")
alertcondition(v_bullConfirmed, title="[LYNX] BUY ENTRY Confirmed",  message="BUY CONFIRMED: {{ticker}} {{interval}} Enter LONG.")
alertcondition(v_bearConfirmed, title="[LYNX] SELL ENTRY Confirmed", message="SELL CONFIRMED: {{ticker}} {{interval}} Enter SHORT.")
alertcondition(v_slHit,         title="[LYNX] Trade Closed",         message="TRADE CLOSED: {{ticker}} {{interval}} SL hit.")
alertcondition(v_waitExpired,   title="[LYNX] Setup Expired",        message="SETUP EXPIRED: {{ticker}} {{interval}} no lower TF confirm.")

var table v_tbl = table.new(position.top_right, 2, 9, border_color=color.new(color.gray, 60), border_width=1, bgcolor=color.new(color.black, 65))

if barstate.islast
    v_hBg  = color.new(#1a237e, 20)
    v_dBg  = color.new(color.black, 50)
    v_grBg = color.new(#1b5e20, 40)
    v_rdBg = color.new(#b71c1c, 40)
    v_wt   = color.white
    table.cell(v_tbl, 0, 0, "LYNX MTF",     bgcolor=v_hBg, text_color=color.yellow, text_size=size.small)
    table.cell(v_tbl, 1, 0, syminfo.ticker, bgcolor=v_hBg, text_color=v_wt,         text_size=size.small)
    table.cell(v_tbl, 0, 1, "Chart / Confirm", bgcolor=v_dBg, text_color=color.yellow, text_size=size.tiny)
    table.cell(v_tbl, 1, 1, v_tfName + " / " + v_ctfName, bgcolor=v_dBg, text_color=v_wt, text_size=size.small)
    v_status = s_waitBull ? "Wait BULL" : s_waitBear ? "Wait BEAR" : s_live ? "TRADE ON" : "Scanning"
    v_sBg    = s_waitBull ? color.new(#00c853, 45) : s_waitBear ? color.new(#f44336, 45) : s_live ? color.new(#f5a623, 35) : color.new(color.gray, 60)
    table.cell(v_tbl, 0, 2, "Status", bgcolor=v_sBg, text_color=v_wt, text_size=size.tiny)
    table.cell(v_tbl, 1, 2, v_status, bgcolor=v_sBg, text_color=v_wt, text_size=size.small)
    table.cell(v_tbl, 0, 3, "Active SL", bgcolor=s_live ? color.new(i_colSL, 40) : color.new(color.gray, 60), text_color=v_wt, text_size=size.tiny)
    table.cell(v_tbl, 1, 3, s_live ? f_px(s_sl) : "---", bgcolor=s_live ? color.new(i_colSL, 40) : color.new(color.gray, 60), text_color=v_wt, text_size=size.small)
    table.cell(v_tbl, 0, 4, "SESSION", bgcolor=v_dBg, text_color=color.gray, text_size=size.tiny)
    table.cell(v_tbl, 1, 4, str.tostring(dayofmonth(timenow)) + "/" + str.tostring(month(timenow)), bgcolor=v_dBg, text_color=color.gray, text_size=size.tiny)
    table.cell(v_tbl, 0, 5, "Signals Today", bgcolor=v_dBg, text_color=v_wt, text_size=size.tiny)
    table.cell(v_tbl, 1, 5, str.tostring(s_sigToday), bgcolor=v_dBg, text_color=color.yellow, text_size=size.small)
    table.cell(v_tbl, 0, 6, "Wins", bgcolor=v_grBg, text_color=v_wt, text_size=size.tiny)
    table.cell(v_tbl, 1, 6, str.tostring(s_winsToday), bgcolor=v_grBg, text_color=v_wt, text_size=size.small)
    table.cell(v_tbl, 0, 7, "Losses", bgcolor=v_rdBg, text_color=v_wt, text_size=size.tiny)
    table.cell(v_tbl, 1, 7, str.tostring(s_lossToday), bgcolor=v_rdBg, text_color=v_wt, text_size=size.small)
    v_bslDist = na(v_pdh) ? na : math.abs(v_pdh - close)
    v_sslDist = na(v_pdl) ? na : math.abs(close - v_pdl)
    table.cell(v_tbl, 0, 8, "BSL / SSL Dist", bgcolor=color.new(#0d47a1, 40), text_color=v_wt, text_size=size.tiny)
    table.cell(v_tbl, 1, 8, f_px(v_bslDist) + " / " + f_px(v_sslDist), bgcolor=color.new(#0d47a1, 40), text_color=v_wt, text_size=size.small)
