{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#0b1220" },
        { "slug": "ink-soft", "name": "Ink Soft", "color": "#1e293b" },
        { "slug": "muted", "name": "Muted", "color": "#64748b" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "background", "name": "Background", "color": "#f1f5f9" },
        { "slug": "accent", "name": "Accent", "color": "#0f766e" },
        { "slug": "accent-soft", "name": "Accent Soft", "color": "#ccfbf1" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Sora\", \"Segoe UI\", sans-serif",
          "name": "Sora",
          "slug": "display"
        },
        {
          "fontFamily": "\"IBM Plex Sans\", \"Segoe UI\", sans-serif",
          "name": "IBM Plex Sans",
          "slug": "body"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1120px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--ink-soft)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent)" }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)"
        },
        "color": { "text": "var(--wp--preset--color--ink)" }
      }
    }
  }
}
